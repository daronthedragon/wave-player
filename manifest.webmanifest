{
  "id": "./",
  "name": "WAVE Player",
  "short_name": "WAVE",
  "description": "Your local music, videos, and saved YouTube and SoundCloud links in an XMB player.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#080d17",
  "theme_color": "#080d17",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share-title",
      "text": "share-text",
      "url": "share-url"
    }
  }
}
